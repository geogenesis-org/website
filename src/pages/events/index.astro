---
import CollectionCard from '../../components/CollectionCard.astro';
import CollectionIndexLayout from '../../layouts/CollectionIndexLayout.astro';
import { formatLaunchTime, formatLongDate } from '../../lib/format';
import { getEventEntries } from '../../lib/content';

const events = await getEventEntries();
---

<CollectionIndexLayout
  title="活动"
  eyebrow="Events"
  intro="讲座、工作坊、开放日与社区活动，连接成员与科研实践。"
  description="GeoGenesis 活动列表：讲座、工作坊与社区活动。"
>
  <div class="grid gap-5">
    {events.map((event) => {
      const meta = [
        { text: formatLongDate(event.data.eventDate), highlight: true },
        ...(event.data.eventTime ? [{ text: formatLaunchTime(event.data.eventTime) }] : []),
        { text: event.data.location },
      ];

      return (
        <CollectionCard
          href={`/events/${event.id}/`}
          title={event.data.title}
          summary={event.data.summary}
          meta={meta}
        />
      );
    })}
  </div>
</CollectionIndexLayout>
