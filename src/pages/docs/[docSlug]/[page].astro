---
import DocLayout from '../../../layouts/DocLayout.astro';
import { prepareDocPage } from '../../../lib/doc-page';
import { getDocEntries } from '../../../lib/content';
import { buildDocSets, findDocSet, parseDocPath } from '../../../lib/docs';

export async function getStaticPaths() {
  const entries = await getDocEntries();
  const docSets = buildDocSets(entries);

  return entries
    .filter((entry) => parseDocPath(entry.id).pageSlug !== 'index')
    .map((entry) => {
      const { docSlug, pageSlug } = parseDocPath(entry.id);
      const docSet = findDocSet(docSets, docSlug);

      if (!docSet) {
        throw new Error(`Missing doc set for entry ${entry.id}`);
      }

      return {
        params: { docSlug, page: pageSlug },
        props: { entry, docSet },
      };
    });
}

const { entry, docSet } = Astro.props;
const { Content, tocHeadings, pageTitle, docMeta } = await prepareDocPage(entry, docSet);
---

<DocLayout title={pageTitle} docSet={docSet} entry={entry} headings={tocHeadings} docMeta={docMeta}>
  <Content />
</DocLayout>
