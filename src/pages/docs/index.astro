---
import CollectionCard from '../../components/CollectionCard.astro';
import CollectionIndexLayout from '../../layouts/CollectionIndexLayout.astro';
import { getDocEntries, getReadingTimeLabel } from '../../lib/content';
import { formatLongDate } from '../../lib/format';

const docs = await getDocEntries();
---

<CollectionIndexLayout
  title="文档"
  eyebrow="Docs"
  intro="课程整理、访谈纪要与研究资料的结构化沉淀。选择一篇文档进入阅读界面。"
  description="GeoGenesis 文档库：课程笔记、访谈整理与研究资料。"
>
  <div class="grid gap-5">
    {docs.map((doc) => (
      <CollectionCard
        href={`/docs/${doc.id}/`}
        title={doc.data.title}
        summary={doc.data.summary}
        ctaLabel="阅读文档"
        meta={[
          { text: doc.data.category, highlight: true },
          { text: formatLongDate(doc.data.publishedAt) },
          { text: getReadingTimeLabel(doc.body ?? '') },
        ]}
      />
    ))}
  </div>
</CollectionIndexLayout>
