---
import { getCollection } from 'astro:content';
import CollectionLayout from '../../layouts/CollectionLayout.astro';
import DocumentArt from '../../components/content/DocumentArt.astro';
import FeaturedContentCard from '../../components/content/FeaturedContentCard.astro';
import ContentListCard from '../../components/content/ContentListCard.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import { sitePath } from '../../utils/paths';

const docs = await getCollection('docs');
const series = docs
  .filter((item) => item.id.endsWith('/index') || !item.id.includes('/'))
  .sort((a, b) => a.data.order - b.data.order);
const featured = series.find((item) => item.data.featured)
  ?? [...series].sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())[0];

const getSeriesSlug = (id: string) => id.replace(/\/index$/, '');
---

<CollectionLayout
  title="文档"
  description="GeoGenesis 地球科学文档、课程笔记与研究导读。"
  eyebrow="GeoGenesis 文档"
  heading="一份写给地球学习者的开放式野外指南。"
  intro="从基础概念、课程笔记到研究导读。每一组文档都提供一条可进入、可追踪、也可以继续贡献的学习路径。"
  marker="DOCUMENTS"
>

  <section class="docs-index shell">
    {featured && (
      <FeaturedContentCard
        href={sitePath(`/docs/${getSeriesSlug(featured.id)}/`)}
        title={featured.data.title}
        summary={featured.data.summary}
        publishedAt={featured.data.publishedAt}
        readTime={featured.data.readTime}
      >
        <DocumentArt slot="visual" tone={featured.data.tone} large />
      </FeaturedContentCard>
    )}

    <SectionHeading
      className="collection-list-heading"
      label="GEOGENESIS 全部文档"
      note="DOCUMENTS /"
    />

    <div class="series-list">
      {series.map((item) => {
        const slug = getSeriesSlug(item.id);
        return (
          <ContentListCard
            href={sitePath(`/docs/${slug}/`)}
            title={item.data.title}
            summary={item.data.summary}
            publishedAt={item.data.publishedAt}
            readTime={item.data.readTime}
          >
            <DocumentArt slot="visual" tone={item.data.tone} />
          </ContentListCard>
        );
      })}
    </div>
  </section>
</CollectionLayout>
