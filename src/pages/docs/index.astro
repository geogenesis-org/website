---
import { getCollection } from 'astro:content';
import CollectionLayout from '../../layouts/CollectionLayout.astro';
import DocumentArt from '../../components/content/DocumentArt.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import { formatContentDate } from '../../utils/content';
import { sitePath } from '../../utils/paths';

const docs = await getCollection('docs');
const series = docs
  .filter((item) => item.id.endsWith('/index') || !item.id.includes('/'))
  .sort((a, b) => a.data.order - b.data.order);
const featured = series.find((item) => item.data.featured)
  ?? [...series].sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())[0];

const getSeriesSlug = (id: string) => id.replace(/\/index$/, '');
---

<CollectionLayout
  title="文档"
  description="GeoGenesis 地球科学文档、课程笔记与研究导读。"
  eyebrow="GeoGenesis 文档"
  heading="一份写给地球学习者的开放式野外指南。"
  intro="从基础概念、课程笔记到研究导读。每一组文档都提供一条可进入、可追踪、也可以继续贡献的学习路径。"
  marker="DOCUMENTS"
>

  <section class="docs-index shell">
    {featured && (
      <a
        class="docs-feature"
        href={sitePath(`/docs/${getSeriesSlug(featured.id)}/`)}
      >
        <DocumentArt tone={featured.data.tone} large />
        <div class="series-copy">
          <div class="series-meta">
            <time datetime={featured.data.publishedAt.toISOString()}>{formatContentDate(featured.data.publishedAt)}</time>
            <span>{featured.data.readTime}</span>
          </div>
          <h2>{featured.data.title}</h2>
          <p>{featured.data.summary}</p>
        </div>
      </a>
    )}

    <SectionHeading
      className="collection-list-heading"
      label="GEOGENESIS 全部文档"
      note="DOCUMENTS /"
    />

    <div class="series-list">
      {series.map((item) => {
        const slug = getSeriesSlug(item.id);
        return (
          <a class="series-card" href={sitePath(`/docs/${slug}/`)}>
            <DocumentArt tone={item.data.tone} />
            <div class="series-copy">
              <div class="series-meta">
                <time datetime={item.data.publishedAt.toISOString()}>{formatContentDate(item.data.publishedAt)}</time>
                <span>{item.data.readTime}</span>
              </div>
              <h2>{item.data.title}</h2>
              <p>{item.data.summary}</p>
            </div>
          </a>
        );
      })}
    </div>
  </section>
</CollectionLayout>
