---
import { getCollection } from 'astro:content';
import CollectionIndex from '../../components/content/CollectionIndex.astro';
import { createDocsListing } from '../../utils/contentListing';

const docs = await getCollection('docs');
const series = docs
  .filter((item) => item.id.endsWith('/index') || !item.id.includes('/'))
  .sort((a, b) => a.data.order - b.data.order);
const selected = series.filter((item) => item.data.featured);
const fallback = [...series].sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
)[0];
const featured = createDocsListing(
  selected.length > 0 ? selected : fallback ? [fallback] : [],
  docs,
);
const listing = createDocsListing(docs);
---

<CollectionIndex section="docs" featured={featured} listing={listing} />
