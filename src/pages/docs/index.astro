---
import DocSidebarLeft from '../../components/DocSidebarLeft.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { pageTitle } from '../../data/site';
import { getDocEntries, getReadingTimeLabel } from '../../lib/content';
import { groupDocsByCategory } from '../../lib/docs';
import { formatLongDate } from '../../lib/format';

const docs = await getDocEntries();
const groups = groupDocsByCategory(docs);
---

<SiteLayout
  title={pageTitle('文档')}
  description="GeoGenesis 文档库：课程笔记、访谈整理与研究资料。"
>
  <div class="doc-shell">
    <DocSidebarLeft groups={groups} />

    <main class="doc-main">
      <header class="doc-article-header max-w-4xl animate-fade-up">
        <p class="font-mono text-[0.72rem] uppercase tracking-[0.18em] text-[var(--color-accent-muted)]">Docs</p>
        <div class="hero-accent-line mt-4"></div>
        <h1 class="doc-article-title mt-5">文档库</h1>
        <p class="doc-article-summary">
          课程整理、访谈纪要与研究资料的结构化沉淀。选择左侧文档，或从下方列表进入阅读。
        </p>
        <p class="mt-3 font-mono text-[0.75rem] text-[var(--body-soft)]">{docs.length} 篇文档</p>
      </header>

      <div class="max-w-4xl overflow-hidden rounded-xl border border-[var(--line-subtle)] bg-[var(--card-bg)] animate-fade-up stagger-1">
        {groups.map((group) => (
          <section>
            <h2 class="border-b border-[var(--line-subtle)] bg-[var(--panel-tint)] px-5 py-3 font-mono text-[0.72rem] uppercase tracking-[0.14em] text-[var(--body-soft)]">
              {group.category}
            </h2>
            {group.entries.map((doc) => (
              <a href={`/docs/${doc.id}/`} class="doc-index-row group block">
                <div>
                  <h3 class="font-display text-[1.1rem] font-semibold leading-snug text-[var(--body-strong)] transition-colors group-hover:text-[var(--nav-active)]">
                    {doc.data.title}
                  </h3>
                  <p class="mt-1 font-mono text-[0.72rem] text-[var(--body-soft)] md:hidden">
                    {formatLongDate(doc.data.publishedAt)} · {getReadingTimeLabel(doc.body ?? '')}
                  </p>
                </div>
                <p class="text-[0.92rem] leading-7 text-[var(--body-muted)]">{doc.data.summary}</p>
                <div class="hidden text-right font-mono text-[0.72rem] text-[var(--body-soft)] md:block">
                  <div>{formatLongDate(doc.data.publishedAt)}</div>
                  <div class="mt-1">{getReadingTimeLabel(doc.body ?? '')}</div>
                </div>
              </a>
            ))}
          </section>
        ))}
      </div>
    </main>
  </div>
</SiteLayout>
