---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import DocumentReaderLayout from '../../layouts/DocumentReaderLayout.astro';
import DocumentArt from '../../components/content/DocumentArt.astro';
import { sitePath } from '../../utils/paths';

export async function getStaticPaths() {
  const docs = await getCollection('docs');
  return docs.map((entry) => ({
    params: { slug: entry.id.replace(/\/index$/, '') },
    props: { entry, docs },
  }));
}

interface Props {
  entry: CollectionEntry<'docs'>;
  docs: CollectionEntry<'docs'>[];
}

const { entry, docs } = Astro.props;
const { Content, headings } = await render(entry);
const parts = entry.id.split('/');
const series = parts.length > 1 ? parts[0] : entry.id;
const siblings = docs
  .filter((item) => item.id === series || item.id.startsWith(`${series}/`))
  .sort((a, b) => a.data.order - b.data.order);
const currentIndex = siblings.findIndex((item) => item.id === entry.id);
const previous = siblings[currentIndex - 1];
const next = siblings[currentIndex + 1];
const seriesTitle = siblings.find((item) => item.id.endsWith('/index'))?.data.title ?? entry.data.title;
const seriesEntry = siblings.find((item) => item.id.endsWith('/index')) ?? entry;
const hrefFor = (id: string) => sitePath(`/docs/${id.replace(/\/index$/, '')}/`);
const navigation = siblings.map((item) => ({
  title: item.data.title,
  href: hrefFor(item.id),
  current: item.id === entry.id,
}));
---

<DocumentReaderLayout
  title={entry.data.title}
  description={entry.data.summary}
  publishedAt={entry.data.publishedAt ?? seriesEntry.data.publishedAt}
  readTime={entry.data.readTime}
  seriesTitle={seriesTitle}
  navigation={navigation}
  headings={headings}
  previous={previous ? { title: previous.data.title, href: hrefFor(previous.id) } : undefined}
  next={next ? { title: next.data.title, href: hrefFor(next.id) } : undefined}
>
  <DocumentArt slot="visual" tone={entry.data.tone} large />
  <Content />
</DocumentReaderLayout>
