---
import { getCollection } from 'astro:content';
import CollectionLayout from '../../layouts/CollectionLayout.astro';
import InterviewArt from '../../components/content/InterviewArt.astro';
import FeaturedContentCard from '../../components/content/FeaturedContentCard.astro';
import ContentListCard from '../../components/content/ContentListCard.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import { getInterviewIdentity } from '../../utils/interviews';
import { sitePath } from '../../utils/paths';

const interviews = (await getCollection('interviews')).sort((a, b) => a.data.order - b.data.order);
const featured = interviews.find((item) => item.data.featured) ?? interviews[0];
const formatInterviewTitle = (identity: ReturnType<typeof getInterviewIdentity>) =>
  `${identity.name} ${identity.affiliation}`;
---

<CollectionLayout
  title="访谈"
  description="与观察、研究和讲述地球的人对话。"
  eyebrow="GeoGenesis 访谈"
  heading="那些正在阅读这颗行星的人。"
  intro="野外笔记、关键转折、开放问题，以及与正在拓展我们对地球理解的人展开的诚实对话。"
  marker="INTERVIEWS"
>

  <section class="interviews shell">
    {featured && (
      <FeaturedContentCard
        href={sitePath(`/interviews/${featured.id}/`)}
        title={featured.data.title}
        summary={formatInterviewTitle(getInterviewIdentity(featured.data))}
        publishedAt={featured.data.publishedAt}
        readTime={featured.data.readTime}
      >
        <InterviewArt slot="visual" tone={featured.data.tone} large />
      </FeaturedContentCard>
    )}

    <SectionHeading
      className="collection-list-heading"
      label="GEOGENESIS 全部访谈"
      note="INTERVIEWS /"
    />
    <div class="interview-list">
      {interviews.map((item) => {
        const identity = getInterviewIdentity(item.data);
        return (
          <ContentListCard
            href={sitePath(`/interviews/${item.id}/`)}
            title={item.data.title}
            summary={formatInterviewTitle(identity)}
            publishedAt={item.data.publishedAt}
            readTime={item.data.readTime}
          >
            <InterviewArt slot="visual" tone={item.data.tone} />
          </ContentListCard>
        );
      })}
    </div>
  </section>
</CollectionLayout>
