---
import { getCollection } from 'astro:content';
import CollectionLayout from '../../layouts/CollectionLayout.astro';
import InterviewArt from '../../components/content/InterviewArt.astro';
import FeaturedContentCard from '../../components/content/FeaturedContentCard.astro';
import PaginatedContentList from '../../components/content/PaginatedContentList.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import { createInterviewsListing } from '../../utils/contentListing';
import { getInterviewIdentity } from '../../utils/interviews';
import { sitePath } from '../../utils/paths';

const interviews = (await getCollection('interviews')).sort((a, b) => a.data.order - b.data.order);
const featured = interviews.find((item) => item.data.featured) ?? interviews[0];
const listing = createInterviewsListing(interviews);
const formatInterviewTitle = (identity: ReturnType<typeof getInterviewIdentity>) =>
  `${identity.name} ${identity.affiliation}`;
---

<CollectionLayout
  title="访谈"
  description="记录观察、研究和讲述地球的人。"
  eyebrow="GeoGenesis 访谈"
  heading="那些正在阅读这颗行星的人。"
  intro="以简短的人物笔记，记录研究者的观察、关键转折与开放问题，以及他们如何拓展我们对地球的理解。"
  marker="INTERVIEWS"
>

  <section class="interviews shell">
    {featured && (
      <FeaturedContentCard
        href={sitePath(`/interviews/${featured.id}/`)}
        title={featured.data.title}
        summary={formatInterviewTitle(getInterviewIdentity(featured.data))}
        publishedAt={featured.data.publishedAt}
        readTime={featured.data.readTime}
      >
        <InterviewArt slot="visual" tone={featured.data.tone} large />
      </FeaturedContentCard>
    )}

    <SectionHeading
      className="collection-list-heading"
      label="GEOGENESIS 全部访谈"
      note="INTERVIEWS /"
    />
    <PaginatedContentList items={listing} section="interviews" className="interview-list" />
  </section>
</CollectionLayout>
