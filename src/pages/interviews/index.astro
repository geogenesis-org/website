---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageIntro from '../../components/PageIntro.astro';
import PortraitArt from '../../components/PortraitArt.astro';

const interviews = (await getCollection('interviews')).sort((a, b) => a.data.order - b.data.order);
const featured = interviews.find((item) => item.data.featured) ?? interviews[0];
---

<BaseLayout title="访谈" description="与观察、研究和讲述地球的人对话。">
  <PageIntro
    eyebrow="GeoGenesis 访谈"
    title="那些正在阅读这颗行星的人。"
    description="野外笔记、关键转折、开放问题，以及与正在拓展我们对地球理解的人展开的诚实对话。"
    index="02"
  />

  <section class="interviews shell">
    {featured && (
      <div class="interview-feature">
        <PortraitArt initials={featured.data.initials} palette={featured.data.palette} issue="FEATURE / 01" large />
        <div class="feature-copy">
          <p class="eyebrow">本期对话 · 01</p>
          <h2>{featured.data.title}</h2>
          <blockquote>“{featured.data.quote}”</blockquote>
          <div class="person-line">
            <strong>{featured.data.guest}</strong>
            <span>{featured.data.role}</span>
          </div>
          <a class="button button-dark" href={`/interviews/${featured.id}/`}>阅读访谈 <span>↗</span></a>
        </div>
      </div>
    )}

    <div class="interview-list-heading">
      <p class="eyebrow">近期对话</p>
      <span>ISSUE 01—{String(interviews.length).padStart(2, '0')}</span>
    </div>
    <div class="interview-grid">
      {interviews.map((item, index) => (
        <a class="interview-card" href={`/interviews/${item.id}/`}>
          <PortraitArt
            initials={item.data.initials}
            palette={item.data.palette}
            issue={String(index + 1).padStart(2, '0')}
          />
          <p class="eyebrow">{item.data.field} · {item.data.location}</p>
          <h2>{item.data.guest}</h2>
          <p class="card-quote">“{item.data.quote}”</p>
          <span class="read-row">阅读对话 <b>↗</b></span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
