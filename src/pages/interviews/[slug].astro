---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import EditorialArticleLayout from '../../layouts/EditorialArticleLayout.astro';
import InterviewArt from '../../components/content/InterviewArt.astro';
import MetaRow from '../../components/ui/MetaRow.astro';
import { formatContentDate } from '../../utils/content';
import { getInterviewIdentity } from '../../utils/interviews';

export async function getStaticPaths() {
  const interviews = await getCollection('interviews');
  return interviews.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<'interviews'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const identity = getInterviewIdentity(entry.data);
---

<EditorialArticleLayout
  title={entry.data.title}
  description={entry.data.summary}
  variant="interview"
>
  <MetaRow
    slot="meta"
    primary={formatContentDate(entry.data.publishedAt)}
    secondary={entry.data.readTime}
    primaryDatetime={entry.data.publishedAt}
  />
  <Fragment slot="visual">
    <InterviewArt tone={entry.data.tone} large />
  </Fragment>
  <Fragment slot="aside">
    <strong>{identity.name}</strong>
    <span>{identity.affiliation}</span>
  </Fragment>
  <Content />
</EditorialArticleLayout>
