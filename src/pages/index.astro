---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ActionLink from '../components/ui/ActionLink.astro';
import ArrowRight from '../components/ui/ArrowRight.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import { formatContentDate } from '../utils/content';
import { sitePath } from '../utils/paths';

const latestNews = (await getCollection('news'))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())
  .slice(0, 5);
const heroImage = sitePath('/images/hero-earth.png');
---

<BaseLayout overlayHeader>
  <section class="home-hero">
    <div class="hero-image" style={`background-image: url("${heroImage}")`} aria-hidden="true"></div>
    <div class="hero-grid" aria-hidden="true"></div>
    <div class="hero-shade" aria-hidden="true"></div>
    <div class="shell hero-content">
      <p class="eyebrow reveal reveal-1">地球科学 · 知识与故事</p>
      <h1 class="display reveal reveal-2">
        探索地球，<br />
        <em>理解我们的行星。</em>
      </h1>
      <p class="hero-copy reveal reveal-3">
        一个由学生共同建设的地球科学知识平台。我们连接严谨的学科内容、真实的科研经验，以及持续发生的地球故事。
      </p>
      <div class="hero-actions reveal reveal-4">
        <ActionLink href={sitePath('/docs/')} variant="text" className="hero-primary-action">
          开始探索
          <ArrowRight slot="icon" />
        </ActionLink>
        <ActionLink href={sitePath('/about/')} variant="text" className="hero-secondary-action">
          了解我们
          <ArrowRight slot="icon" />
        </ActionLink>
      </div>
    </div>
    <div class="shell hero-meta">
      <span>34.5° N · 18,000 KM</span>
    </div>
  </section>

  <section class="manifesto section shell">
    <p class="eyebrow">我们的视角</p>
    <div>
      <h2 class="section-title">
        地球不是事实的集合，<br />
        <em>而是一个仍在展开的故事。</em>
      </h2>
      <p class="large-copy">
        我们把行星的尺度与复杂性转化为清晰、耐读的知识体验，同时保留让科学真正重要的证据、方法与不确定性。
      </p>
    </div>
  </section>

  <section class="home-portals section shell">
    <SectionHeading label="探索 GeoGenesis" />
    <div class="portal-grid">
      <a class="portal-card strata" href={sitePath('/docs/')}>
        <div class="portal-art"><span></span></div>
        <div class="card-content">
          <h3>文档</h3>
          <p>从行星内部到塑造地表的系统，建立一条清晰、可持续深入的地球科学学习路径。</p>
          <span class="card-link">学习 <b>↗</b></span>
        </div>
      </a>
      <a class="portal-card contours" href={sitePath('/interviews/')}>
        <div class="portal-art"><span></span></div>
        <div class="card-content">
          <h3>访谈</h3>
          <p>与那些观察、测绘、建模和讲述这颗变化中行星的人相遇。</p>
          <span class="card-link">聆听 <b>↗</b></span>
        </div>
      </a>
    </div>
  </section>

  <section class="home-news section shell">
    <SectionHeading label="最近发生" note="全部动态 ↗" noteHref={sitePath('/news/')} />
    <div class="home-news-list">
      {latestNews.map((item) => (
        <a href={sitePath(`/news/${item.id}/`)}>
          <div>
            <p class="eyebrow">{formatContentDate(item.data.publishedAt)} · {item.data.readTime}</p>
            <h2>{item.data.title}</h2>
          </div>
          <span class="home-news-arrow">↗</span>
        </a>
      ))}
    </div>
  </section>

  <section class="quote-band">
    <div class="shell quote-inner">
      <p class="eyebrow">一颗运动中的行星</p>
      <blockquote>现在是通往过去的钥匙，<em>也是我们对未来的责任。</em></blockquote>
      <div class="planet-facts">
        <div><strong>45.4</strong><span>亿年的行星历史</span></div>
        <div><strong>1</strong><span>个相互连接的地球系统</span></div>
        <div><strong>∞</strong><span>仍待探索的问题</span></div>
      </div>
    </div>
  </section>
</BaseLayout>
