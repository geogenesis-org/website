---
import CollectionLayout from '../layouts/CollectionLayout.astro';
import ActionLink from '../components/ui/ActionLink.astro';
import ArrowRight from '../components/ui/ArrowRight.astro';
import { pillars } from '../data/site';
import { sitePath } from '../utils/paths';
---

<CollectionLayout
  title="关于我们"
  description="了解 GeoGenesis 的使命、原则和内容共建方式。"
  eyebrow="关于 GeoGenesis"
  heading="让地球科学走向更多人，让更多人走近地球科学。"
  intro="我们用清晰、可靠且有吸引力的内容降低入门门槛，同时不省略证据、方法与科学认识中的不确定性。"
  marker="ABOUT"
>

  <section class="about-statement shell">
    <p class="eyebrow">我们的使命</p>
    <p>
      我们希望帮助初学者从兴趣走向系统理解：建立相互关联的知识框架，认识观察、实验与建模等研究方法，并从真实的学习与科研经验中看见继续深入的方向。
    </p>
  </section>

  <section class="principles shell">
    {pillars.map((pillar) => (
      <article>
        <span>{pillar.index}</span>
        <h2>{pillar.title}</h2>
        <p>{pillar.description}</p>
      </article>
    ))}
  </section>

  <section class="about-story">
    <div class="shell story-grid">
      <div>
        <p class="eyebrow">为什么是 GeoGenesis</p>
        <h2>在兴趣与系统学习之间，<br /><em>需要一条更清晰的路径。</em></h2>
      </div>
      <div class="story-copy">
        <p>从高中走进大学，许多学习者会遇到知识、方法与经验的断层。课程目录列出了要学什么，却很少解释这些知识如何关联、研究问题怎样展开，以及面对众多方向时该从哪里开始。</p>
        <p>GeoGenesis 希望补上这段衔接。我们由学生发起并共同维护，把基础知识、学习方法与真实的科研经验整理成开放、可持续更新的内容，让每一位初学者都更容易找到起点，也看见继续深入的方向。</p>
      </div>
    </div>
  </section>

  <section class="about-cta">
    <div class="shell">
      <p class="eyebrow">开始探索</p>
      <h2>换一种方式，<br />看见地球。</h2>
      <ActionLink href={sitePath('/docs/')} variant="text" className="about-cta-link">
        打开文档
        <ArrowRight slot="icon" wide />
      </ActionLink>
    </div>
  </section>
</CollectionLayout>
