---
import { getCollection } from 'astro:content';
import CollectionIndex from '../../components/content/CollectionIndex.astro';
import { createNewsListing } from '../../utils/contentListing';

const news = (await getCollection('news')).sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
);
const selected = news.filter((item) => item.data.featured);
const featured = createNewsListing(selected.length > 0 ? selected : news.slice(0, 1));
const listing = createNewsListing(news);
---

<CollectionIndex section="news" featured={featured} listing={listing} />
