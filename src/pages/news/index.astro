---
import PageHero from '../../components/PageHero.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { getNewsEntries, getReadingTimeLabel } from '../../lib/content';
import { formatLongDate } from '../../lib/format';
import { pageTitle } from '../../data/site';

const newsEntries = await getNewsEntries();
---

<SiteLayout title={pageTitle('动态')} description="GeoGenesis 组织公告、社区更新与阶段性进展。">
  <main class="mx-auto max-w-[90rem] px-6 py-14 sm:px-8 sm:py-18 lg:px-10 lg:py-22">
    <PageHero eyebrow="News" title="动态" description="组织公告、社区更新与阶段性进展。" />

    <section class="mt-12 grid gap-5 animate-fade-up stagger-2">
      {newsEntries.map((entry, index) => (
        <a
          href={`/news/${entry.id}/`}
          class="surface-card group block rounded-xl p-6 sm:p-7"
          style={`animation-delay: ${index * 0.05}s`}
        >
          <div class="flex flex-wrap items-center gap-3 font-mono text-[0.72rem] text-[var(--body-soft)]">
            <span class="text-[var(--color-copper)]">{entry.data.category}</span>
            <span aria-hidden="true">·</span>
            <span>{formatLongDate(entry.data.publishedAt)}</span>
            <span aria-hidden="true">·</span>
            <span>{getReadingTimeLabel(entry.body ?? '')}</span>
          </div>
          <h2 class="mt-4 font-display text-[clamp(1.35rem,2.5vw,1.85rem)] font-semibold leading-snug tracking-[-0.01em] text-[var(--body-strong)] transition-colors group-hover:text-[var(--nav-active)]">
            {entry.data.title}
          </h2>
          <p class="mt-3 max-w-3xl text-[0.98rem] leading-7 text-[var(--body-muted)]">{entry.data.summary}</p>
          <p class="mt-4 text-sm text-[var(--body-soft)]">{entry.data.author}</p>
        </a>
      ))}
    </section>
  </main>
</SiteLayout>
