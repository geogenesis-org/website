---
import CollectionCard from '../../components/CollectionCard.astro';
import CollectionIndexLayout from '../../layouts/CollectionIndexLayout.astro';
import { getNewsEntries, getReadingTimeLabel } from '../../lib/content';
import { formatLongDate } from '../../lib/format';

const newsEntries = await getNewsEntries();
---

<CollectionIndexLayout
  title="动态"
  eyebrow="News"
  intro="组织公告、社区更新与阶段性进展。"
  description="GeoGenesis 组织公告、社区更新与阶段性进展。"
>
  <div class="grid gap-5">
    {newsEntries.map((entry) => (
      <CollectionCard
        href={`/news/${entry.id}/`}
        title={entry.data.title}
        summary={entry.data.summary}
        footer={entry.data.author}
        ctaLabel="阅读全文"
        meta={[
          { text: entry.data.category, highlight: true },
          { text: formatLongDate(entry.data.publishedAt) },
          { text: getReadingTimeLabel(entry.body ?? '') },
        ]}
      />
    ))}
  </div>
</CollectionIndexLayout>
