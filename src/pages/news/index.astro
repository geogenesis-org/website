---
import { getCollection } from 'astro:content';
import CollectionLayout from '../../layouts/CollectionLayout.astro';
import NewsArt from '../../components/content/NewsArt.astro';
import FeaturedContentCard from '../../components/content/FeaturedContentCard.astro';
import PaginatedContentList from '../../components/content/PaginatedContentList.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import { createNewsListing } from '../../utils/contentListing';
import { sitePath } from '../../utils/paths';

const news = (await getCollection('news')).sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
);
const featured = news.find((item) => item.data.featured) ?? news[0];
const listing = createNewsListing(news);
---

<CollectionLayout
  title="动态"
  description="GeoGenesis 的项目进展、编辑手记与社区消息。"
  eyebrow="GeoGenesis 动态"
  heading="记录正在发生的事，也留下我们如何抵达这里。"
  intro="项目进展、编辑手记与社区消息。这里记录 GeoGenesis 的每一步，也公开内容如何被讨论、修订和共同完成。"
  marker="NEWS"
>

  <section class="news-index shell">
    {featured && (
      <FeaturedContentCard
        href={sitePath(`/news/${featured.id}/`)}
        title={featured.data.title}
        summary={featured.data.summary}
        publishedAt={featured.data.publishedAt}
        readTime={featured.data.readTime}
      >
        <NewsArt slot="visual" tone={featured.data.tone} large />
      </FeaturedContentCard>
    )}

    <SectionHeading
      className="collection-list-heading"
      label="GEOGENESIS 全部活动"
      note="NEWS /"
    />

    <PaginatedContentList items={listing} section="news" className="news-list" />
  </section>
</CollectionLayout>
