---
import { getCollection } from 'astro:content';
import CollectionLayout from '../../layouts/CollectionLayout.astro';
import NewsArt from '../../components/content/NewsArt.astro';
import MetaRow from '../../components/ui/MetaRow.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import { formatContentDate } from '../../utils/content';

const news = (await getCollection('news')).sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
);
const featured = news.find((item) => item.data.featured) ?? news[0];
const remaining = news.filter((item) => item.id !== featured?.id);
---

<CollectionLayout
  title="动态"
  description="GeoGenesis 的项目进展、编辑手记与社区消息。"
  eyebrow="GeoGenesis 动态"
  heading="记录正在发生的事，也留下我们如何抵达这里。"
  intro="项目进展、编辑手记与社区消息。这里记录 GeoGenesis 的每一步，也公开内容如何被讨论、修订和共同完成。"
  index="03"
>

  <section class="news-index shell">
    {featured && (
      <a class="news-feature" href={`/news/${featured.id}/`}>
        <NewsArt tone={featured.data.tone} index="LATEST / 01" large />
        <div class="news-feature-copy">
          <MetaRow
            className="news-meta"
            primary={formatContentDate(featured.data.publishedAt)}
            secondary={featured.data.readTime}
            primaryDatetime={featured.data.publishedAt}
          />
          <p class="eyebrow">最新动态</p>
          <h2>{featured.data.title}</h2>
          <p>{featured.data.summary}</p>
          <span class="read-row">阅读全文 <b>↗</b></span>
        </div>
      </a>
    )}

    <SectionHeading
      className="news-list-heading"
      label="全部动态"
      note={`${String(news.length).padStart(2, '0')} STORIES · 2026`}
    />

    <div class="news-list">
      {remaining.map((item, index) => (
        <a class="news-row" href={`/news/${item.id}/`}>
          <span class="news-row-index">{String(index + 2).padStart(2, '0')}</span>
          <NewsArt tone={item.data.tone} index={String(index + 2).padStart(2, '0')} />
          <div class="news-row-copy">
            <MetaRow
              className="news-meta"
              primary={formatContentDate(item.data.publishedAt)}
              secondary={item.data.readTime}
              primaryDatetime={item.data.publishedAt}
            />
            <h2>{item.data.title}</h2>
            <p>{item.data.summary}</p>
          </div>
          <span class="news-arrow">↗</span>
        </a>
      ))}
    </div>
  </section>
</CollectionLayout>
