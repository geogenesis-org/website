---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import EditorialArticleLayout from '../../layouts/EditorialArticleLayout.astro';
import NewsArt from '../../components/content/NewsArt.astro';
import MetaRow from '../../components/ui/MetaRow.astro';
import { formatContentDate } from '../../utils/content';

export async function getStaticPaths() {
  const news = await getCollection('news');
  return news.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<'news'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<EditorialArticleLayout
  title={entry.data.title}
  description={entry.data.summary}
  variant="news"
>
  <MetaRow
    slot="meta"
    primary={formatContentDate(entry.data.publishedAt)}
    secondary={entry.data.readTime}
    primaryDatetime={entry.data.publishedAt}
  />
  <NewsArt slot="visual" tone={entry.data.tone} large />
  <Content />
</EditorialArticleLayout>
