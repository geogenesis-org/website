---
import { render } from 'astro:content';

import EditorialEntryLayout from '../../layouts/EditorialEntryLayout.astro';
import { getNewsEntries, getReadingTimeLabel } from '../../lib/content';
import { formatLongDate } from '../../lib/format';

export async function getStaticPaths() {
  const newsEntries = await getNewsEntries();
  return newsEntries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<EditorialEntryLayout
  title={entry.data.title}
  eyebrow={entry.data.category}
  summary={entry.data.summary}
  image={entry.data.image}
  backHref="/news/"
  backLabel="全部动态"
  details={[
    { label: '发布日期', value: formatLongDate(entry.data.publishedAt) },
    { label: '阅读时长', value: getReadingTimeLabel(entry.body ?? '') },
    { label: '作者', value: entry.data.author },
    { label: '分类', value: entry.data.category },
  ]}
>
  <Content />
</EditorialEntryLayout>
