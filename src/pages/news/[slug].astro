---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import EditorialArticleLayout from '../../layouts/EditorialArticleLayout.astro';
import NewsArt from '../../components/content/NewsArt.astro';
import MetaRow from '../../components/ui/MetaRow.astro';
import { formatContentDate } from '../../utils/content';
import { sitePath } from '../../utils/paths';

export async function getStaticPaths() {
  const news = await getCollection('news');
  return news.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<'news'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<EditorialArticleLayout
  title={entry.data.title}
  description={entry.data.summary}
  backHref={sitePath('/news/')}
  backLabel="所有动态"
  variant="news"
>
  <MetaRow
    slot="meta"
    primary={formatContentDate(entry.data.publishedAt)}
    secondary={entry.data.readTime}
    primaryDatetime={entry.data.publishedAt}
  />
  <NewsArt slot="visual" tone={entry.data.tone} large />
  <Fragment slot="aside">
    <p class="eyebrow">文章信息</p>
    <time datetime={entry.data.publishedAt.toISOString()}>{formatContentDate(entry.data.publishedAt)}</time>
    <span>{entry.data.readTime}</span>
    <hr />
    <a href={sitePath('/news/')}>返回动态目录 →</a>
  </Fragment>
  <Content />
</EditorialArticleLayout>
