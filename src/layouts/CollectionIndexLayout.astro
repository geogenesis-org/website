---
import SiteLayout from './SiteLayout.astro';
import { pageTitle } from '../data/site';

interface Props {
  description?: string;
  intro: string;
  title: string;
  eyebrow: string;
  fullWidth?: boolean;
}

const { description, eyebrow, intro, title, fullWidth = false } = Astro.props;
---

<SiteLayout title={pageTitle(title)} description={description}>
  <main class:list={['px-6 py-14 sm:px-8 sm:py-18 lg:px-12 lg:py-22', fullWidth ? 'mx-auto max-w-[90rem]' : 'mx-auto max-w-7xl']}>
    <section class="max-w-4xl animate-fade-up">
      <div class="section-header-meta">
        <span class="section-header-label">{eyebrow}</span>
        <span class="section-header-strata" aria-hidden="true"></span>
      </div>
      <h1 class="section-header-title">{title}</h1>
      <p class="section-header-desc">{intro}</p>
    </section>
    <section class="mt-12 animate-fade-up stagger-2">
      <slot />
    </section>
  </main>
</SiteLayout>
