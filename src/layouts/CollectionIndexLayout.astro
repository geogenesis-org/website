---
import SectionHeader from '../components/SectionHeader.astro';
import SiteLayout from './SiteLayout.astro';
import { pageTitle } from '../data/site';

interface Props {
  description?: string;
  intro: string;
  title: string;
  eyebrow: string;
}

const { description, eyebrow, intro, title } = Astro.props;
---

<SiteLayout title={pageTitle(title)} description={description}>
  <main class="mx-auto max-w-[90rem] px-6 py-14 sm:px-8 sm:py-18 lg:px-10 lg:py-22">
    <SectionHeader label={eyebrow} title={title} description={intro} headingLevel="h1" />
    <section class="mt-12 animate-fade-up stagger-2">
      <slot />
    </section>
  </main>
</SiteLayout>
