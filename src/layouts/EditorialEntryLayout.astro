---
import SiteLayout from './SiteLayout.astro';
import { pageTitle } from '../data/site';

interface DetailItem {
  label: string;
  value: string;
}

interface Props {
  backHref: string;
  backLabel: string;
  description?: string;
  details: DetailItem[];
  eyebrow: string;
  image?: string;
  summary: string;
  title: string;
}

const {
  backHref,
  backLabel,
  description,
  details,
  eyebrow,
  image,
  summary,
  title,
} = Astro.props;
---

<SiteLayout title={pageTitle(title)} description={description ?? summary}>
  <main class="mx-auto max-w-4xl px-6 py-14 sm:px-8 sm:py-18 lg:px-10">
    <a
      href={backHref}
      class="inline-flex items-center gap-2 font-mono text-[0.72rem] uppercase tracking-[0.12em] text-[var(--body-soft)] transition-colors hover:text-[var(--nav-active)]"
    >
      <span aria-hidden="true">←</span>
      {backLabel}
    </a>

    <header class="mt-8 animate-fade-up">
      <p class="font-mono text-[0.72rem] uppercase tracking-[0.14em] text-[var(--color-accent-muted)]">{eyebrow}</p>
      <div class="hero-accent-line mt-4"></div>
      <h1 class="mt-5 font-display text-[clamp(1.85rem,3.5vw,2.75rem)] font-semibold leading-[1.15] tracking-[-0.02em] text-[var(--body-strong)]">
        {title}
      </h1>
      <p class="mt-4 text-[1.05rem] leading-8 text-[var(--body-muted)]">{summary}</p>
    </header>

    <div class="mt-8 grid gap-8 lg:grid-cols-[minmax(0,1fr)_240px] lg:items-start">
      <div>
        {image ? (
          <div class="mb-8 overflow-hidden rounded-xl border border-[var(--line-subtle)]">
            <img src={image} alt={title} class="aspect-[16/9] w-full object-cover" />
          </div>
        ) : null}

        <article class="markdown-prose animate-fade-up stagger-1">
          <slot />
        </article>
      </div>

      <aside class="rounded-xl border border-[var(--line-subtle)] bg-[var(--card-bg)] p-5 lg:sticky lg:top-24">
        <p class="font-mono text-[0.68rem] uppercase tracking-[0.12em] text-[var(--body-soft)]">文章信息</p>
        <dl class="mt-4 space-y-4">
          {details.map((item) => (
            <div>
              <dt class="font-mono text-[0.65rem] uppercase tracking-[0.08em] text-[var(--body-soft)]">{item.label}</dt>
              <dd class="mt-1 text-[0.92rem] leading-6 text-[var(--body-muted)]">{item.value}</dd>
            </div>
          ))}
        </dl>
      </aside>
    </div>
  </main>
</SiteLayout>
