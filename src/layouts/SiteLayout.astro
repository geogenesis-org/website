---
import FooterSection from '../components/FooterSection';
import BrandLogo from '../components/BrandLogo';
import ThemeToggle from '../components/ThemeToggle';
import { footerDirectory, footerMeta, footerPolicies, siteMeta, siteNav } from '../data/site';
import '../styles/global.css';

interface Props {
  description?: string;
  title: string;
}

const { description = siteMeta.description, title } = Astro.props;
const currentPath = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;

function normalizePath(path: string) {
  if (path === '/') {
    return '/';
  }

  return path.endsWith('/') ? path : `${path}/`;
}

function isActivePath(path: string) {
  const normalizedPath = normalizePath(path);

  if (normalizedPath === '/') {
    return currentPath === '/';
  }

  return currentPath === normalizedPath || currentPath.startsWith(normalizedPath);
}
---

<html lang={siteMeta.lang} class="bg-page-bg">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;1,9..40,400&family=IBM+Plex+Mono:wght@400;500&family=Newsreader:ital,opsz,wght@0,6..72,500;0,6..72,600;0,6..72,700;1,6..72,400&display=swap"
    />
    <script is:inline>
      (() => {
        const key = 'geogenesis-theme';
        const stored = window.localStorage.getItem(key);
        const theme = stored === 'light' || stored === 'dark' ? stored : 'dark';
        document.documentElement.dataset.theme = theme;
        document.documentElement.classList.toggle('dark', theme === 'dark');
      })();
    </script>
    <title>{title}</title>
  </head>
  <body class="bg-page-bg font-body antialiased">
    <div class="site-shell min-h-screen overflow-x-clip">
      <header
        data-site-header
        data-scroll-state="top"
        class="site-header sticky top-0 z-50 transition-transform duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] will-change-transform data-[scroll-state=hidden]:-translate-y-full"
      >
        <div class="mx-auto flex max-w-[90rem] items-center justify-between gap-4 px-6 py-4 sm:px-8 lg:px-10">
          <a href="/" class="inline-flex items-center transition-opacity duration-300 hover:opacity-85">
            <BrandLogo />
          </a>

          <nav class="hidden items-center gap-1 md:flex" aria-label="主导航">
            {siteNav.map((item) => {
              const isActive = isActivePath(item.href);

              return (
                <a
                  href={item.href}
                  aria-current={isActive ? 'page' : undefined}
                  class="nav-link px-3 py-2 text-[0.88rem] font-medium"
                >
                  {item.label}
                </a>
              );
            })}
          </nav>

          <div class="flex items-center gap-2 sm:gap-3">
            <ThemeToggle client:load className="h-9 w-9" />
            <details class="group relative md:hidden">
              <summary
                class="theme-toggle inline-flex h-9 w-9 cursor-pointer list-none items-center justify-center rounded-lg [&::-webkit-details-marker]:hidden"
                aria-label="菜单"
              >
                <span class="sr-only">菜单</span>
                <span class="flex flex-col gap-1 group-open:hidden" aria-hidden="true">
                  <span class="block h-px w-4 bg-current"></span>
                  <span class="block h-px w-4 bg-current"></span>
                  <span class="block h-px w-4 bg-current"></span>
                </span>
                <span class="relative hidden h-4 w-4 group-open:block" aria-hidden="true">
                  <span class="absolute block h-px w-4 rotate-45 bg-current"></span>
                  <span class="absolute block h-px w-4 -rotate-45 bg-current"></span>
                </span>
              </summary>
              <nav class="absolute right-0 top-[calc(100%+0.5rem)] z-50 min-w-[12rem] rounded-xl border border-[var(--line-subtle)] bg-[var(--color-surface)] p-2 shadow-xl">
                {siteNav.map((item) => {
                  const isActive = isActivePath(item.href);

                  return (
                    <a
                      href={item.href}
                      aria-current={isActive ? 'page' : undefined}
                      class="block rounded-lg px-3 py-2 text-sm font-medium text-[var(--body-muted)] transition-colors hover:bg-[var(--panel-hover)] hover:text-[var(--nav-active)]"
                    >
                      {item.label}
                    </a>
                  );
                })}
              </nav>
            </details>
          </div>
        </div>
      </header>
      <script is:inline>
        (() => {
          const header = document.querySelector('[data-site-header]');
          if (!header) return;

          let lastScrollY = window.scrollY;
          let ticking = false;
          const revealDelta = 8;
          const topOffset = 24;

          const updateHeader = () => {
            const currentScrollY = window.scrollY;
            const delta = currentScrollY - lastScrollY;

            if (currentScrollY <= topOffset) {
              header.setAttribute('data-scroll-state', 'top');
            } else if (delta > revealDelta) {
              header.setAttribute('data-scroll-state', 'hidden');
            } else if (delta < -revealDelta) {
              header.setAttribute('data-scroll-state', 'visible');
            }

            lastScrollY = currentScrollY;
            ticking = false;
          };

          window.addEventListener(
            'scroll',
            () => {
              if (!ticking) {
                window.requestAnimationFrame(updateHeader);
                ticking = true;
              }
            },
            { passive: true },
          );
        })();
      </script>
      <slot />
      <FooterSection
        client:visible
        directory={footerDirectory}
        meta={footerMeta}
        policies={footerPolicies}
      />
    </div>
  </body>
</html>
