---
import BaseLayout from './BaseLayout.astro';
import PageIntro from '../components/ui/PageIntro.astro';

interface Props {
  title: string;
  description: string;
  eyebrow: string;
  heading: string;
  intro: string;
  marker: string;
}

const { title, description, eyebrow, heading, intro, marker } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <PageIntro eyebrow={eyebrow} title={heading} description={intro} marker={marker} />
  <slot />
</BaseLayout>
