---
import BaseLayout from './BaseLayout.astro';
import { formatContentDate } from '../utils/content';
import MetaRow from '../components/ui/MetaRow.astro';

interface NavigationItem {
  title: string;
  href: string;
  current: boolean;
}

interface HeadingItem {
  depth: number;
  slug: string;
  text: string;
}

interface ChapterLink {
  title: string;
  href: string;
}

interface Props {
  title: string;
  description?: string;
  publishedAt: Date;
  readTime: string;
  seriesTitle: string;
  navigation: NavigationItem[];
  headings: HeadingItem[];
  previous?: ChapterLink;
  next?: ChapterLink;
}

const {
  title,
  description,
  publishedAt,
  readTime,
  seriesTitle,
  navigation,
  headings,
  previous,
  next,
} = Astro.props;
---

<BaseLayout title={title} description={description}>
  <div class="doc-layout shell">
    <aside class="doc-sidebar">
      <h2>{seriesTitle}</h2>
      <nav aria-label="系列文章">
        {navigation.map((item) => (
          <a href={item.href} aria-current={item.current ? 'page' : undefined}>
            {item.title}
          </a>
        ))}
      </nav>
    </aside>

    <article class="document">
      <header class="document-header">
        <MetaRow
          className="document-meta"
          primary={formatContentDate(publishedAt)}
          secondary={readTime}
          primaryDatetime={publishedAt}
        />
        <h1>{title}</h1>
        {description && <p class="document-lead">{description}</p>}
      </header>
      {Astro.slots.has('visual') && <slot name="visual" />}
      <div class="prose"><slot /></div>
      {(previous || next) && (
        <nav class="document-pagination" aria-label="文档翻页">
          {previous && (
            <a class="document-pagination-previous" href={previous.href}>
              <span>← 上一页</span>
              <strong>{previous.title}</strong>
            </a>
          )}
          {next && (
            <a class="document-pagination-next" href={next.href}>
              <span>下一页 →</span>
              <strong>{next.title}</strong>
            </a>
          )}
        </nav>
      )}
    </article>

    <aside class="doc-toc">
      <p class="eyebrow">目录</p>
      {headings.filter((heading) => heading.depth <= 3).map((heading) => (
        <a class:list={[`depth-${heading.depth}`]} href={`#${heading.slug}`}>{heading.text}</a>
      ))}
    </aside>
  </div>
</BaseLayout>
