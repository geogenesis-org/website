---
import BaseLayout from './BaseLayout.astro';
import { formatContentDate } from '../utils/content';
import { sitePath } from '../utils/paths';

interface NavigationItem {
  title: string;
  href: string;
  current: boolean;
}

interface HeadingItem {
  depth: number;
  slug: string;
  text: string;
}

interface NextItem {
  title: string;
  href: string;
}

interface Props {
  title: string;
  description?: string;
  publishedAt: Date;
  readTime: string;
  seriesTitle: string;
  currentIndex: number;
  navigation: NavigationItem[];
  headings: HeadingItem[];
  next?: NextItem;
}

const {
  title,
  description,
  publishedAt,
  readTime,
  seriesTitle,
  currentIndex,
  navigation,
  headings,
  next,
} = Astro.props;
const position = currentIndex + 1;
---

<BaseLayout title={title} description={description}>
  <div class="doc-topbar">
    <div class="shell">
      <a href={sitePath('/docs/')}>← 返回文档</a>
      <span>{seriesTitle}</span>
      <span>{String(position).padStart(2, '0')} / {String(navigation.length).padStart(2, '0')}</span>
    </div>
  </div>

  <div class="doc-layout shell">
    <aside class="doc-sidebar">
      <p class="eyebrow">本系列</p>
      <h2>{seriesTitle}</h2>
      <nav aria-label="系列文章">
        {navigation.map((item, index) => (
          <a href={item.href} aria-current={item.current ? 'page' : undefined}>
            <span>{String(index + 1).padStart(2, '0')}</span>
            {item.title}
          </a>
        ))}
      </nav>
      <div class="doc-progress">
        <span>阅读进度</span>
        <div><i style={`width: ${(position / navigation.length) * 100}%`}></i></div>
        <b>{position} / {navigation.length}</b>
      </div>
    </aside>

    <article class="document">
      <header class="document-header">
        <div class="document-meta">
          <time datetime={publishedAt.toISOString()}>{formatContentDate(publishedAt)}</time>
          <span>{readTime}</span>
        </div>
        <h1>{title}</h1>
        {description && <p class="document-lead">{description}</p>}
      </header>
      {Astro.slots.has('visual') && <slot name="visual" />}
      <div class="prose"><slot /></div>
      {next && (
        <div class="next-chapter">
          <span>继续阅读</span>
          <a href={next.href}>
            <b>{String(position + 1).padStart(2, '0')}</b>
            <span>{next.title}</span>
            <i>→</i>
          </a>
        </div>
      )}
    </article>

    <aside class="doc-toc">
      <p class="eyebrow">本页目录</p>
      {headings.filter((heading) => heading.depth <= 3).map((heading) => (
        <a class:list={[`depth-${heading.depth}`]} href={`#${heading.slug}`}>{heading.text}</a>
      ))}
    </aside>
  </div>
</BaseLayout>
