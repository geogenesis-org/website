---
import BaseLayout from './BaseLayout.astro';
import { formatContentDate } from '../utils/content';
import MetaRow from '../components/ui/MetaRow.astro';
import ArticleBackLink from '../components/ui/ArticleBackLink.astro';
import { collectionReturnStateKey } from '../utils/contentListing';
import { sitePath } from '../utils/paths';

interface NavigationItem {
  title: string;
  href: string;
  current: boolean;
}

interface HeadingItem {
  depth: number;
  slug: string;
  text: string;
}

interface ChapterLink {
  title: string;
  href: string;
}

interface Props {
  title: string;
  description?: string;
  publishedAt: Date;
  readTime: string;
  seriesTitle: string;
  seriesHref: string;
  seriesCurrent: boolean;
  navigation: NavigationItem[];
  headings: HeadingItem[];
  previous?: ChapterLink;
  next?: ChapterLink;
}

const {
  title,
  description,
  publishedAt,
  readTime,
  seriesTitle,
  seriesHref,
  seriesCurrent,
  navigation,
  headings,
  previous,
  next,
} = Astro.props;
const tocHeadings = headings.filter((heading) => heading.depth <= 3);
const returnStateKey = collectionReturnStateKey('docs');
---

<BaseLayout title={title} description={description}>
  <div class="doc-layout shell">
    <aside class="doc-sidebar">
      <h2>
        <a href={seriesHref} aria-current={seriesCurrent ? 'page' : undefined}>
          {seriesTitle}
        </a>
      </h2>
      {navigation.length > 0 && (
        <nav aria-label={`${seriesTitle}章节`}>
          {navigation.map((item) => (
            <a href={item.href} aria-current={item.current ? 'page' : undefined}>
              {item.title}
            </a>
          ))}
        </nav>
      )}
    </aside>

    <nav
      class:list={['doc-mobile-navigation', { 'has-page-toc': tocHeadings.length > 0 }]}
      aria-label="文档导航"
    >
      <details class="doc-mobile-disclosure">
        <summary>
          <span>章节导航</span>
        </summary>
        <div class="doc-mobile-links">
          <a href={seriesHref} aria-current={seriesCurrent ? 'page' : undefined}>
            {seriesTitle}
          </a>
          {navigation.map((item) => (
            <a href={item.href} aria-current={item.current ? 'page' : undefined}>
              {item.title}
            </a>
          ))}
        </div>
      </details>

      {tocHeadings.length > 0 && (
        <details class="doc-mobile-disclosure">
          <summary>
            <span>本页目录</span>
          </summary>
          <div class="doc-mobile-links doc-mobile-toc">
            {tocHeadings.map((heading) => (
              <a class:list={[`depth-${heading.depth}`]} href={`#${heading.slug}`}>
                {heading.text}
              </a>
            ))}
          </div>
        </details>
      )}
    </nav>

    <article class="document">
      <header class="document-header">
        <div class="article-meta-row">
          <ArticleBackLink
            href={sitePath('/docs/')}
            label="返回文档库"
            returnStateKey={returnStateKey}
          />
          <MetaRow
            className="document-meta"
            primary={formatContentDate(publishedAt)}
            secondary={readTime}
            primaryDatetime={publishedAt}
          />
        </div>
        <h1>{title}</h1>
        {description && <p class="document-lead">{description}</p>}
      </header>
      {Astro.slots.has('visual') && <slot name="visual" />}
      <div class="prose"><slot /></div>
      {(previous || next) && (
        <nav class="document-pagination" aria-label="文档翻页">
          {previous && (
            <a class="document-pagination-previous" href={previous.href}>
              <span>← 上一页</span>
              <strong>{previous.title}</strong>
            </a>
          )}
          {next && (
            <a class="document-pagination-next" href={next.href}>
              <span>下一页 →</span>
              <strong>{next.title}</strong>
            </a>
          )}
        </nav>
      )}
    </article>

    <aside class="doc-toc">
      <p class="eyebrow">目录</p>
      {tocHeadings.map((heading) => (
        <a class:list={[`depth-${heading.depth}`]} href={`#${heading.slug}`}>{heading.text}</a>
      ))}
    </aside>
  </div>

  <script>
    document.querySelectorAll<HTMLElement>('.doc-mobile-navigation').forEach((navigation) => {
      const disclosures = [...navigation.querySelectorAll<HTMLDetailsElement>('.doc-mobile-disclosure')];
      const closeAll = () => disclosures.forEach((disclosure) => {
        disclosure.open = false;
      });

      disclosures.forEach((disclosure) => {
        disclosure.addEventListener('toggle', () => {
          if (!disclosure.open) return;
          disclosures.forEach((other) => {
            if (other !== disclosure) other.open = false;
          });
        });
      });

      document.addEventListener('pointerdown', (event) => {
        if (!navigation.contains(event.target as Node)) closeAll();
      });
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') closeAll();
      });
    });
  </script>
</BaseLayout>
