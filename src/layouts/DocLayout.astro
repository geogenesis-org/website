---
import DocSidebarLeft from '../components/DocSidebarLeft.astro';
import DocToc from '../components/DocToc';
import SiteLayout from './SiteLayout.astro';
import { pageTitle } from '../data/site';
import type { DocHeading, DocSet } from '../lib/docs';
import { getDocPageHref, getCurrentPageIndex, parseDocPath } from '../lib/docs';
import type { DocEntry } from '../lib/content';

interface MetaItem {
  label: string;
  value: string;
}

interface Props {
  title: string;
  docSet: DocSet;
  entry: DocEntry;
  headings: DocHeading[];
  docMeta: MetaItem[];
  description?: string;
}

const { title, docSet, entry, headings, docMeta, description } = Astro.props;
const { pageSlug } = parseDocPath(entry.id);
const pageSummary = entry.data.summary;
const currentIndex = getCurrentPageIndex(docSet, entry.id);
const prevPage = currentIndex > 0 ? docSet.pages[currentIndex - 1] : null;
const nextPage = currentIndex >= 0 && currentIndex < docSet.pages.length - 1 ? docSet.pages[currentIndex + 1] : null;
---

<SiteLayout title={pageTitle(title)} description={description ?? pageSummary ?? docSet.summary}>
  <div class="doc-mobile-nav px-4 py-3 lg:hidden">
    <label class="sr-only" for="doc-page-select">切换页面</label>
    <select
      id="doc-page-select"
      class="w-full rounded-lg border border-[var(--line-subtle)] bg-[var(--color-surface)] px-3 py-2.5 text-sm text-[var(--body-strong)]"
      onchange="if (this.value) window.location.href = this.value"
    >
      {docSet.pages.map((page) => {
        const { pageSlug: slug } = parseDocPath(page.id);
        return (
          <option value={getDocPageHref(docSet.slug, slug)} selected={page.id === entry.id}>
            {page.data.title}
          </option>
        );
      })}
    </select>
  </div>

  <div class="doc-shell">
    <DocSidebarLeft docSet={docSet} currentEntryId={entry.id} docMeta={docMeta} />

    <main class="doc-main">
      <a
        href="/docs/"
        class="mb-6 inline-flex items-center gap-2 font-mono text-[0.72rem] uppercase tracking-[0.12em] text-[var(--body-soft)] transition-colors hover:text-[var(--nav-active)]"
      >
        <span aria-hidden="true">←</span>
        文档库
      </a>

      <header class="doc-article-header animate-fade-up">
        <p class="font-mono text-[0.72rem] uppercase tracking-[0.14em] text-[var(--color-copper)]">
          {docSet.category}
          {pageSlug !== 'index' ? ` · ${entry.data.title}` : null}
        </p>
        <h1 class="doc-article-title mt-3">{title}</h1>
        {pageSummary ? <p class="doc-article-summary">{pageSummary}</p> : null}
      </header>

      <article class="doc-article-body markdown-prose doc-prose animate-fade-up stagger-1">
        <slot />
      </article>

      {(prevPage || nextPage) && (
        <nav class="doc-pager" aria-label="文档分页导航">
          {prevPage ? (
            <a href={getDocPageHref(docSet.slug, parseDocPath(prevPage.id).pageSlug)} class="doc-pager-link doc-pager-prev">
              <span class="doc-pager-label">上一页</span>
              <span class="doc-pager-title">{prevPage.data.title}</span>
            </a>
          ) : (
            <span />
          )}
          {nextPage ? (
            <a href={getDocPageHref(docSet.slug, parseDocPath(nextPage.id).pageSlug)} class="doc-pager-link doc-pager-next">
              <span class="doc-pager-label">下一页</span>
              <span class="doc-pager-title">{nextPage.data.title}</span>
            </a>
          ) : (
            <span />
          )}
        </nav>
      )}
    </main>

    <aside class="doc-sidebar doc-sidebar-right hidden xl:block">
      <div class="doc-sidebar-inner">
        <p class="doc-sidebar-label">本页目录</p>
        <DocToc client:load headings={headings} />
      </div>
    </aside>
  </div>
</SiteLayout>
