---
import SiteLayout from './SiteLayout.astro';
import { pageTitle } from '../data/site';

interface Highlight {
  label: string;
  value: string;
}

interface Props {
  description?: string;
  eyebrow: string;
  highlights?: Highlight[];
  image?: string;
  summary: string;
  title: string;
}

const { description, eyebrow, highlights = [], image, summary, title } = Astro.props;
---

<SiteLayout title={pageTitle(title)} description={description ?? summary}>
  <main class="mx-auto max-w-4xl px-6 py-14 sm:px-8 sm:py-18 lg:px-10">
    <section
      class:list={[
        'relative overflow-hidden rounded-2xl border border-[var(--line-subtle)]',
        image ? 'min-h-[320px] sm:min-h-[400px]' : 'page-hero px-7 py-10 sm:px-10 sm:py-12',
      ]}
    >
      {image ? (
        <>
          <img src={image} alt={title} class="absolute inset-0 h-full w-full object-cover" />
          <div class="absolute inset-0 bg-gradient-to-t from-[var(--color-page-bg)] via-[var(--color-page-bg)]/60 to-transparent" />
        </>
      ) : null}

      <div class:list={['relative z-10 animate-fade-up', image ? 'flex min-h-[320px] items-end p-7 sm:min-h-[400px] sm:p-10' : '']}>
        <div class="max-w-3xl">
          <p class="font-mono text-[0.72rem] uppercase tracking-[0.14em] text-[var(--color-accent-muted)]">{eyebrow}</p>
          <div class="hero-accent-line mt-4"></div>
          <h1 class="mt-5 font-display text-[clamp(2rem,4vw,3rem)] font-semibold leading-[1.1] tracking-[-0.02em] text-[var(--body-strong)]">
            {title}
          </h1>
          <p class="mt-4 text-[1.05rem] leading-8 text-[var(--body-muted)]">{summary}</p>
        </div>
      </div>
    </section>

    <section class="mt-10 grid gap-10 md:grid-cols-[minmax(0,1fr)_260px] md:items-start">
      <article class="markdown-prose animate-fade-up stagger-1">
        <slot />
      </article>

      {highlights.length ? (
        <aside class="rounded-xl border border-[var(--line-subtle)] bg-[var(--card-bg)] p-5 md:sticky md:top-24">
          <p class="font-mono text-[0.68rem] uppercase tracking-[0.12em] text-[var(--body-soft)]">核心信息</p>
          <dl class="mt-4 space-y-4">
            {highlights.map((item) => (
              <div>
                <dt class="font-mono text-[0.65rem] uppercase tracking-[0.08em] text-[var(--color-copper)]">{item.label}</dt>
                <dd class="mt-1.5 text-[0.92rem] leading-6 text-[var(--body-muted)]">{item.value}</dd>
              </div>
            ))}
          </dl>
        </aside>
      ) : null}
    </section>
  </main>
</SiteLayout>
