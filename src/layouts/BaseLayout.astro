---
import SiteHeader from '../components/site/SiteHeader.astro';
import SiteFooter from '../components/site/SiteFooter.astro';
import ScrollToTop from '../components/site/ScrollToTop.astro';
import { pageTitle, siteMeta } from '../data/site';
import { sitePath } from '../utils/paths';
import '@fontsource-variable/noto-sans-sc/wght.css';
import '@fontsource-variable/noto-serif-sc/wght.css';
import '@fontsource/ibm-plex-mono/latin-400.css';
import '@fontsource/ibm-plex-mono/latin-500.css';
import 'katex/dist/katex.min.css';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  overlayHeader?: boolean;
  hideFooter?: boolean;
}

const {
  title,
  description = siteMeta.description,
  overlayHeader = false,
  hideFooter = false,
} = Astro.props;
---

<!doctype html>
<html lang={siteMeta.lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#101413" />
    <link rel="icon" type="image/svg+xml" href={sitePath('/favicon.svg')} />
    <title>{title ? pageTitle(title) : `${siteMeta.name} | ${siteMeta.tagline}`}</title>
    <script is:inline>
      (() => {
        const saved = localStorage.getItem('geogenesis-theme');
        const preferred = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.dataset.theme = saved || preferred;
      })();
    </script>
  </head>
  <body>
    <SiteHeader overlay={overlayHeader} />
    <main><slot /></main>
    {!hideFooter && <SiteFooter />}
    <ScrollToTop />
  </body>
</html>
