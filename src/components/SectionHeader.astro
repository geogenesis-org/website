---
interface Props {
  label: string;
  title: string;
  description?: string;
  class?: string;
  headingLevel?: 'h1' | 'h2';
}

const { label, title, description, class: className = '', headingLevel = 'h2' } = Astro.props;
const HeadingTag = headingLevel;
---

<div class:list={['section-header animate-fade-up', className]}>
  <div class="section-header-meta">
    <span class="section-header-label">{label}</span>
    <span class="section-header-strata" aria-hidden="true"></span>
  </div>
  <HeadingTag class="section-header-title">{title}</HeadingTag>
  {description ? <p class="section-header-desc">{description}</p> : null}
</div>
