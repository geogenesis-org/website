---
import logoMarkUrl from '../../assets/brand/logo-mark.svg?url';
---

<span
  class="site-mark"
  style={`--site-mark-image: url("${logoMarkUrl}")`}
  aria-hidden="true"
></span>

<style>
  .site-mark {
    width: 38px;
    height: 22px;
    flex: 0 0 auto;
    display: inline-block;
    background: currentColor;
    -webkit-mask: var(--site-mark-image) center / contain no-repeat;
    mask: var(--site-mark-image) center / contain no-repeat;
  }
</style>
