---
import SiteMark from './SiteMark.astro';
import { footerConfig, siteNav } from '../../data/site';
import { sitePath } from '../../utils/paths';
---

<footer class="site-footer">
  <div class="shell">
    <div class="footer-main">
      <div class="footer-brand">
        <a class="site-identity" href={sitePath('/')} aria-label="GeoGenesis 首页">
          <SiteMark />
          <span class="site-wordmark">GeoGenesis</span>
        </a>
        <p>{footerConfig.slogan}</p>
      </div>

      <div class="footer-link-columns">
        <div class="footer-sections">
          <p>板块</p>
          <nav aria-label="页脚板块导航">
            {siteNav.map((item) => <a href={item.href}>{item.label}</a>)}
          </nav>
        </div>

        <div class="footer-media">
          <p>媒体</p>
          <nav class="footer-socials" aria-label="社交媒体">
            {footerConfig.socialLinks.map((item) => item.type === 'link' ? (
              <a href={item.href} target="_blank" rel="noreferrer" aria-label={item.label} title={item.label}>
                <span
                  class="footer-social-icon"
                  style={`--social-icon: url("${sitePath(item.icon)}")`}
                  aria-hidden="true"
                ></span>
              </a>
            ) : (
              <div class="footer-social-qr" data-wechat-qr>
                <button
                  class="footer-social-button"
                  type="button"
                  aria-label={`显示${item.label}二维码`}
                  aria-describedby="wechat-qr-panel"
                  title={item.label}
                  data-wechat-toggle
                >
                  <span
                    class="footer-social-icon"
                    style={`--social-icon: url("${sitePath(item.icon)}")`}
                    aria-hidden="true"
                  ></span>
                </button>
                <div
                  id="wechat-qr-panel"
                  class="footer-social-qr-panel"
                  role="tooltip"
                  aria-label="微信扫码关注 GeoGenesis"
                >
                  <img
                    src={sitePath(item.image)}
                    width="430"
                    height="430"
                    loading="lazy"
                    alt="GeoGenesis 微信公众号二维码"
                  />
                </div>
              </div>
            ))}
          </nav>
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <span>{footerConfig.rights}</span>
      {footerConfig.filing.enabled && footerConfig.filing.label && (
        <a href={footerConfig.filing.href} target="_blank" rel="noreferrer">
          {footerConfig.filing.label}
        </a>
      )}
    </div>
  </div>
</footer>

<script>
  const wechatQr = document.querySelector<HTMLElement>('[data-wechat-qr]');
  const wechatToggle = document.querySelector<HTMLButtonElement>('[data-wechat-toggle]');

  const setWechatOpen = (open: boolean, dismissed = false) => {
    if (!wechatQr) return;
    wechatQr.dataset.open = String(open);
    if (open) delete wechatQr.dataset.dismissed;
    else if (dismissed) wechatQr.dataset.dismissed = 'true';
  };

  wechatToggle?.addEventListener('click', (event) => {
    event.stopPropagation();
    const shouldOpen = wechatQr?.dataset.open !== 'true' || wechatQr.dataset.dismissed === 'true';
    setWechatOpen(shouldOpen, !shouldOpen);
  });
  document.addEventListener('click', (event) => {
    if (!wechatQr?.contains(event.target as Node)) setWechatOpen(false);
  });
  document.addEventListener('keydown', (event) => {
    if (!wechatQr || event.key !== 'Escape') return;
    const isVisible = wechatQr.dataset.open === 'true'
      || wechatQr.matches(':hover')
      || wechatQr.contains(document.activeElement);
    if (!isVisible) return;
    setWechatOpen(false, true);
  });
  wechatQr?.addEventListener('pointerleave', () => delete wechatQr.dataset.dismissed);
  wechatQr?.addEventListener('focusout', () => delete wechatQr.dataset.dismissed);
</script>
