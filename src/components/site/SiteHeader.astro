---
import SiteMark from './SiteMark.astro';
import { siteNav } from '../../data/site';
import { sitePath } from '../../utils/paths';

interface Props {
  overlay?: boolean;
}

const { overlay = false } = Astro.props;
const pathname = Astro.url.pathname;
---

<header class:list={['site-header', { overlay }]}> 
  <div class="shell header-inner">
    <a class="site-identity" href={sitePath('/')} aria-label="GeoGenesis 首页">
      <SiteMark />
      <span class="site-wordmark">GeoGenesis</span>
    </a>

    <nav class="primary-nav" aria-label="主导航">
      {siteNav.map((item) => (
        <a href={item.href} aria-current={pathname.startsWith(item.href) ? 'page' : undefined}>
          {item.label}
        </a>
      ))}
    </nav>

    <div class="header-actions">
      <button class="theme-toggle" type="button" aria-label="切换至深色主题" title="切换至深色主题" aria-pressed="false">
        <svg class="sun" viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2"></path>
        </svg>
        <svg class="moon" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M20.4 14.6A8.5 8.5 0 0 1 9.4 3.6 8.5 8.5 0 1 0 20.4 14.6Z"></path>
        </svg>
      </button>
      <button class="menu-toggle" type="button" aria-label="打开导航" aria-expanded="false">
        <span></span><span></span>
      </button>
    </div>
  </div>

  <nav class="mobile-nav" aria-label="移动端导航">
    {siteNav.map((item) => (
      <a href={item.href} aria-current={pathname.startsWith(item.href) ? 'page' : undefined}>
        {item.label}
      </a>
    ))}
  </nav>
</header>

<script>
  const header = document.querySelector('.site-header');
  const menu = header?.querySelector<HTMLButtonElement>('.menu-toggle');
  const themeToggle = header?.querySelector<HTMLButtonElement>('.theme-toggle');

  menu?.addEventListener('click', () => {
    const open = header?.classList.toggle('menu-open') ?? false;
    menu.setAttribute('aria-expanded', String(open));
    menu.setAttribute('aria-label', open ? '关闭导航' : '打开导航');
  });

  const syncThemeToggle = () => {
    if (!themeToggle) return;
    const dark = document.documentElement.dataset.theme === 'dark';
    const label = dark ? '切换至浅色主题' : '切换至深色主题';
    themeToggle.setAttribute('aria-label', label);
    themeToggle.setAttribute('title', label);
    themeToggle.setAttribute('aria-pressed', String(dark));
  };

  themeToggle?.addEventListener('click', () => {
    const root = document.documentElement;
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    localStorage.setItem('geogenesis-theme', next);
    syncThemeToggle();
  });

  syncThemeToggle();
</script>
