---
import SiteMark from './SiteMark.astro';
import { siteNav } from '../../data/site';
import { sitePath } from '../../utils/paths';

interface Props {
  overlay?: boolean;
}

const { overlay = false } = Astro.props;
const pathname = Astro.url.pathname;
---

<header class:list={['site-header', { overlay }]}> 
  <div class="shell header-inner">
    <a class="site-identity" href={sitePath('/')} aria-label="GeoGenesis 首页">
      <SiteMark />
      <span>GeoGenesis</span>
    </a>

    <nav class="primary-nav" aria-label="主导航">
      {siteNav.map((item) => (
        <a href={item.href} aria-current={pathname.startsWith(item.href) ? 'page' : undefined}>
          {item.label}
        </a>
      ))}
    </nav>

    <div class="header-actions">
      <button class="theme-toggle" type="button" aria-label="切换明暗主题" title="切换明暗主题">
        <svg class="sun" viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="12" cy="12" r="3.5"></circle>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.65 17.65l1.42 1.42M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.65 6.35l1.42-1.42"></path>
        </svg>
        <svg class="moon" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M20.4 14.6A8.5 8.5 0 0 1 9.4 3.6 8.5 8.5 0 1 0 20.4 14.6Z"></path>
        </svg>
      </button>
      <button class="menu-toggle" type="button" aria-label="打开导航" aria-expanded="false">
        <span></span><span></span>
      </button>
    </div>
  </div>

  <nav class="mobile-nav" aria-label="移动端导航">
    {siteNav.map((item, index) => (
      <a href={item.href} aria-current={pathname.startsWith(item.href) ? 'page' : undefined}>
        <span>0{index + 1}</span>{item.label}<b>↗</b>
      </a>
    ))}
  </nav>
</header>

<script>
  const header = document.querySelector('.site-header');
  const menu = header?.querySelector<HTMLButtonElement>('.menu-toggle');
  menu?.addEventListener('click', () => {
    const open = header?.classList.toggle('menu-open') ?? false;
    menu.setAttribute('aria-expanded', String(open));
    menu.setAttribute('aria-label', open ? '关闭导航' : '打开导航');
  });

  document.querySelector('.theme-toggle')?.addEventListener('click', () => {
    const root = document.documentElement;
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    localStorage.setItem('geogenesis-theme', next);
  });
</script>
