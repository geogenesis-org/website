---
interface Props {
  eyebrow: string;
  title: string;
  description: string;
  index?: string;
}

const { eyebrow, title, description, index = '01' } = Astro.props;
---

<section class="page-intro shell">
  <div class="intro-meta">
    <p class="eyebrow">{eyebrow}</p>
    <span>{index} / GEO</span>
  </div>
  <h1>{title}</h1>
  <p class="intro-copy">{description}</p>
</section>
