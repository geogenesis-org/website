---
interface Props {
  href: string;
  label: string;
  returnStateKey?: string;
}

const { href, label, returnStateKey } = Astro.props;
---

<a
  class="article-back-link"
  href={href}
  aria-label={label}
  title={label}
  data-article-back
  data-return-state-key={returnStateKey}
>
  <svg viewBox="0 0 24 24" aria-hidden="true">
    <path d="m10 6-6 6 6 6M4.5 12H20"></path>
  </svg>
</a>

<script>
  document.querySelectorAll<HTMLAnchorElement>('[data-article-back]').forEach((link) => {
    link.addEventListener('click', (event) => {
      if (
        event.defaultPrevented
        || event.button !== 0
        || event.metaKey
        || event.ctrlKey
        || event.shiftKey
        || event.altKey
      ) return;

      const normalizePath = (pathname: string) => pathname.replace(/\/+$/, '') || '/';
      const destination = new URL(link.href);
      const returnStateKey = link.dataset.returnStateKey;
      const savedReturnState = returnStateKey
        ? sessionStorage.getItem(returnStateKey)
        : null;

      if (returnStateKey && savedReturnState) {
        try {
          const state = JSON.parse(savedReturnState) as { url?: string };
          const returnUrl = state.url ? new URL(state.url) : destination;
          if (returnUrl.origin === window.location.origin) {
            event.preventDefault();
            sessionStorage.setItem(`${returnStateKey}:restore`, 'true');
            window.location.assign(returnUrl.href);
            return;
          }
        } catch {
          sessionStorage.removeItem(returnStateKey);
        }
      }

      if (window.history.length <= 1 || !document.referrer) return;
      const previous = new URL(document.referrer);
      const cameFromDestination = previous.origin === window.location.origin
        && normalizePath(previous.pathname) === normalizePath(destination.pathname);

      if (cameFromDestination) {
        event.preventDefault();
        window.history.back();
      }
    });
  });
</script>

<style>
  .article-back-link {
    width: 44px;
    height: 44px;
    display: grid;
    flex: 0 0 44px;
    place-items: center;
    border-radius: 50%;
    color: var(--muted);
    transition:
      color 180ms ease,
      background-color 180ms ease,
      transform 220ms cubic-bezier(.22, 1, .36, 1);
  }

  .article-back-link:hover {
    color: var(--primary);
    background: var(--primary-soft);
    transform: translateX(-2px);
  }

  .article-back-link svg {
    width: 19px;
    height: 19px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  @media (hover: none) {
    .article-back-link:hover { transform: none; }
    .article-back-link:active {
      color: var(--primary);
      background: var(--primary-soft);
      transform: scale(.94);
    }
  }
</style>
