---
import { Icon } from '@twodft/astro-icon/components';

import { footerCopyright, footerSocialLinks, siteMeta } from '../data/site';

function isExternalLink(href: string) {
  return href.startsWith('http');
}
---

<footer id="site-footer" class="site-footer">
  <div class="site-footer-inner">
    <div class="site-footer-top">
      <p class="site-footer-name">{siteMeta.name}</p>

      <nav class="site-footer-social" aria-label="Contact and social media">
        <ul class="site-footer-social-list">
          {footerSocialLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="site-footer-social-link"
                aria-label={link.label}
                target={isExternalLink(link.href) ? '_blank' : undefined}
                rel={isExternalLink(link.href) ? 'noopener noreferrer' : undefined}
              >
                <Icon name={link.icon} class="site-footer-social-icon" />
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>

    <p class="site-footer-copyright">{footerCopyright}</p>
  </div>
</footer>
