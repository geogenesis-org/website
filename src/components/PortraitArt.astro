---
interface Props {
  initials: string;
  palette?: 'sage' | 'rust' | 'blue';
  issue?: string;
  large?: boolean;
}

const { initials, palette = 'sage', issue, large = false } = Astro.props;
---

<div class:list={['portrait-art', `palette-${palette}`, { large }]}>
  <div class="contour-lines"></div>
  <span class="portrait-initials">{initials}</span>
  {issue && <span class="portrait-issue">{issue}</span>}
  <span class="coordinate">FIELD NOTES · 2026</span>
</div>
