---
import type { DocSet } from '../lib/docs';
import { getDocPageHref, getCurrentPageIndex, parseDocPath } from '../lib/docs';

interface DocMetaItem {
  label: string;
  value: string;
}

interface Props {
  docSet: DocSet;
  currentEntryId: string;
  docMeta?: DocMetaItem[];
}

const { docSet, currentEntryId, docMeta = [] } = Astro.props;
const currentIndex = getCurrentPageIndex(docSet, currentEntryId);
---

<aside class="doc-sidebar doc-sidebar-left hidden lg:block">
  <div class="doc-sidebar-inner">
    <div class="doc-sidebar-doc">
      <p class="doc-sidebar-label">当前文档</p>
      <p class="doc-sidebar-doc-title">{docSet.title}</p>
      {docSet.summary ? <p class="doc-sidebar-doc-summary">{docSet.summary}</p> : null}
    </div>

    <nav class="doc-sidebar-pages" aria-label={`${docSet.title} 页面导航`}>
      <p class="doc-sidebar-label">页面</p>
      <ol class="doc-page-list">
        {docSet.pages.map((page, index) => {
          const { pageSlug } = parseDocPath(page.id);
          const href = getDocPageHref(docSet.slug, pageSlug);
          const isCurrent = page.id === currentEntryId;

          return (
            <li>
              <a href={href} class="doc-nav-link" aria-current={isCurrent ? 'page' : undefined}>
                <span class="doc-page-index">{String(index + 1).padStart(2, '0')}</span>
                <span class="doc-page-title">{page.data.title}</span>
              </a>
            </li>
          );
        })}
      </ol>
    </nav>

    {docMeta.length ? (
      <div class="doc-sidebar-meta">
        <p class="doc-sidebar-label">文档信息</p>
        <dl class="doc-meta-list">
          {docMeta.map((item) => (
            <div class="doc-meta-row">
              <dt>{item.label}</dt>
              <dd>{item.value}</dd>
            </div>
          ))}
          {currentIndex >= 0 ? (
            <div class="doc-meta-row">
              <dt>进度</dt>
              <dd>
                {currentIndex + 1} / {docSet.pages.length}
              </dd>
            </div>
          ) : null}
        </dl>
      </div>
    ) : null}
  </div>
</aside>
