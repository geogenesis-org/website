---
interface Props {
  tone?: 'light' | 'mid' | 'dark';
  large?: boolean;
}

const { tone = 'mid', large = false } = Astro.props;
---

<div
  class:list={['document-art', `tone-${tone}`, { large }]}
  role="img"
  aria-label="GeoGenesis 文档视觉"
>
  <span class="visual-label">GEO / DOCUMENTS</span>
  <span class="document-texture" aria-hidden="true"></span>
  <span class="document-shape" aria-hidden="true"></span>
</div>
