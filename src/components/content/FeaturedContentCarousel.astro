---
import FeaturedContentCard from './FeaturedContentCard.astro';
import ContentVisual from './ContentVisual.astro';
import type { ContentListItem } from '../../utils/contentListing';
import { visibleIndexWindow } from '../../utils/indexDots';

interface Props {
  items: ContentListItem[];
  autoplay?: boolean;
  interval?: number;
  label?: string;
}

const {
  items,
  autoplay = false,
  interval = 7000,
  label = '精选内容',
} = Astro.props;
const hasMultiple = items.length > 1;
const initialDots = visibleIndexWindow(items.length, 1);
const panels = hasMultiple
  ? [
      { item: items[items.length - 1], originalIndex: items.length - 1, clone: true },
      ...items.map((item, originalIndex) => ({ item, originalIndex, clone: false })),
      { item: items[0], originalIndex: 0, clone: true },
    ]
  : items.map((item, originalIndex) => ({ item, originalIndex, clone: false }));
---

{items.length > 0 && (
  <section
    class="featured-carousel"
    aria-label={label}
    aria-roledescription="轮播展板"
    data-featured-carousel
    data-autoplay={autoplay && hasMultiple ? 'true' : 'false'}
    data-interval={Math.max(interval, 3000)}
  >
    <div class="featured-carousel-viewport">
      <div
        class="featured-carousel-track"
        style={hasMultiple ? 'transform: translateX(-100%)' : undefined}
        data-carousel-track
      >
        {panels.map(({ item, originalIndex, clone }) => (
          <div
            class="featured-carousel-slide"
            role="group"
            aria-roledescription="幻灯片"
            aria-label={`${originalIndex + 1} / ${items.length}`}
            aria-hidden={!clone && originalIndex === 0 ? 'false' : 'true'}
            inert={clone || originalIndex > 0}
            data-carousel-panel
            data-carousel-original={clone ? undefined : ''}
          >
            <FeaturedContentCard
              href={item.href}
              title={item.title}
              summary={item.summary}
              publishedAt={new Date(item.publishedAt)}
              readTime={item.readTime}
            >
              <ContentVisual slot="visual" visual={item.visual} tone={item.tone} large />
            </FeaturedContentCard>
          </div>
        ))}
      </div>
    </div>

    {hasMultiple && (
      <>
        <button class="featured-carousel-arrow is-previous" type="button" aria-label="上一篇精选" data-carousel-previous>
          <svg viewBox="0 0 32 32" aria-hidden="true">
            <path d="M20.5 6.5 11 16l9.5 9.5" />
          </svg>
        </button>
        <button class="featured-carousel-arrow is-next" type="button" aria-label="下一篇精选" data-carousel-next>
          <svg viewBox="0 0 32 32" aria-hidden="true">
            <path d="m11.5 6.5 9.5 9.5-9.5 9.5" />
          </svg>
        </button>
        <div class="featured-carousel-footer">
          <div class="featured-carousel-dots" aria-label="选择精选内容" data-carousel-dots>
            {initialDots.flatMap((page, index) => {
              const preceding = initialDots[index - 1];
              const zeroBased = page - 1;
              const nodes = [];
              if (preceding && page - preceding > 1) {
                nodes.push(<span class="index-dot-gap" aria-hidden="true"></span>);
              }
              nodes.push(
                <button
                  class:list={['featured-carousel-dot', { 'is-current': zeroBased === 0 }]}
                  type="button"
                  aria-label={`显示第 ${page} 篇精选`}
                  aria-current={zeroBased === 0 ? 'true' : undefined}
                  data-carousel-dot={zeroBased}
                ></button>,
              );
              return nodes;
            })}
          </div>
          <p class="featured-carousel-status" aria-live="polite" data-carousel-status></p>
        </div>
      </>
    )}
  </section>
)}

<script>
  import { visibleIndexWindow } from '../../utils/indexDots';

  document.querySelectorAll<HTMLElement>('[data-featured-carousel]').forEach((carousel) => {
    const viewport = carousel.querySelector<HTMLElement>('.featured-carousel-viewport');
    const track = carousel.querySelector<HTMLElement>('[data-carousel-track]');
    const panels = [...carousel.querySelectorAll<HTMLElement>('[data-carousel-panel]')];
    const slides = [...carousel.querySelectorAll<HTMLElement>('[data-carousel-original]')];
    const dotsHost = carousel.querySelector<HTMLElement>('[data-carousel-dots]');
    const previous = carousel.querySelector<HTMLButtonElement>('[data-carousel-previous]');
    const next = carousel.querySelector<HTMLButtonElement>('[data-carousel-next]');
    const status = carousel.querySelector<HTMLElement>('[data-carousel-status]');
    if (!viewport || !track || slides.length < 2 || !dotsHost || !previous || !next || !status) return;

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const autoplayConfigured = carousel.dataset.autoplay === 'true';
    const interval = Number(carousel.dataset.interval ?? '7000');
    let current = 0;
    let physical = 1;
    let animating = false;
    let pausedByInteraction = false;
    let timer: number | undefined;

    const stopTimer = () => {
      if (timer) window.clearTimeout(timer);
      timer = undefined;
    };

    const schedule = () => {
      stopTimer();
      if (!autoplayConfigured || reduceMotion || pausedByInteraction || document.hidden) return;
      timer = window.setTimeout(() => move(1, false), interval);
    };

    const revealActiveDot = () => {
      const activeDot = dotsHost.querySelector<HTMLElement>('.featured-carousel-dot.is-current');
      if (!activeDot || dotsHost.scrollWidth <= dotsHost.clientWidth) return;
      const left = activeDot.offsetLeft - (dotsHost.clientWidth - activeDot.offsetWidth) / 2;
      dotsHost.scrollTo({
        left: Math.max(0, left),
        behavior: reduceMotion ? 'auto' : 'smooth',
      });
    };

    const playDotsMotion = (direction: number) => {
      if (reduceMotion || direction === 0) return;
      const cls = direction > 0 ? 'is-advancing' : 'is-retreating';
      dotsHost.classList.remove('is-advancing', 'is-retreating');
      void dotsHost.offsetWidth;
      dotsHost.classList.add(cls);
    };

    const renderDots = (direction = 0) => {
      const pages = visibleIndexWindow(slides.length, current + 1);
      const fragment = document.createDocumentFragment();

      pages.forEach((page, index) => {
        const preceding = pages[index - 1];
        if (preceding && page - preceding > 1) {
          const gap = document.createElement('span');
          gap.className = 'index-dot-gap';
          gap.setAttribute('aria-hidden', 'true');
          fragment.append(gap);
        }

        const zeroBased = page - 1;
        const active = zeroBased === current;
        const dot = document.createElement('button');
        dot.type = 'button';
        dot.className = 'featured-carousel-dot';
        if (active) {
          dot.classList.add('is-current');
          dot.setAttribute('aria-current', 'true');
        }
        dot.dataset.carouselDot = String(zeroBased);
        dot.setAttribute('aria-label', `显示第 ${page} 篇精选`);
        fragment.append(dot);
      });

      dotsHost.replaceChildren(fragment);
      playDotsMotion(direction);
      requestAnimationFrame(revealActiveDot);
    };

    const updateState = (announce: boolean, direction = 0) => {
      slides.forEach((slide, index) => {
        const active = index === current;
        slide.setAttribute('aria-hidden', String(!active));
        slide.toggleAttribute('inert', !active);
      });
      renderDots(direction);
      status.textContent = announce ? `已显示第 ${current + 1} 篇精选，共 ${slides.length} 篇` : '';
    };

    const move = (direction: -1 | 1, announce = true) => {
      if (animating) return;
      animating = true;
      current = (current + direction + slides.length) % slides.length;
      physical += direction;
      track.classList.remove('is-jump');
      track.style.transform = `translateX(-${physical * 100}%)`;
      updateState(announce, direction);
      schedule();
    };

    const goTo = (target: number) => {
      if (animating || target === current) return;
      const direction = target > current ? 1 : -1;
      animating = true;
      current = target;
      physical = target + 1;
      track.classList.remove('is-jump');
      track.style.transform = `translateX(-${physical * 100}%)`;
      updateState(true, direction);
      schedule();
    };

    track.addEventListener('transitionend', (event) => {
      if (event.propertyName !== 'transform') return;
      if (physical === 0 || physical === slides.length + 1) {
        physical = physical === 0 ? slides.length : 1;
        track.classList.add('is-jump');
        track.style.transform = `translateX(-${physical * 100}%)`;
        track.getBoundingClientRect();
        track.classList.remove('is-jump');
      }
      animating = false;
    });

    previous.addEventListener('click', () => move(-1));
    next.addEventListener('click', () => move(1));
    dotsHost.addEventListener('click', (event) => {
      const target = (event.target as HTMLElement | null)?.closest<HTMLButtonElement>('[data-carousel-dot]');
      if (!target || !dotsHost.contains(target)) return;
      const index = Number(target.dataset.carouselDot);
      if (Number.isInteger(index)) goTo(index);
    });

    let touchStart: { id: number; x: number; y: number } | undefined;
    let suppressClick = false;

    viewport.addEventListener('pointerdown', (event) => {
      if (event.pointerType !== 'touch') return;
      touchStart = { id: event.pointerId, x: event.clientX, y: event.clientY };
      pausedByInteraction = true;
      stopTimer();
    });

    viewport.addEventListener('pointerup', (event) => {
      if (!touchStart || event.pointerId !== touchStart.id) return;
      const deltaX = event.clientX - touchStart.x;
      const deltaY = event.clientY - touchStart.y;
      touchStart = undefined;
      pausedByInteraction = false;

      if (Math.abs(deltaX) >= 50 && Math.abs(deltaX) > Math.abs(deltaY) * 1.25) {
        suppressClick = true;
        move(deltaX < 0 ? 1 : -1);
        window.setTimeout(() => {
          suppressClick = false;
        }, 0);
      } else {
        schedule();
      }
    });

    viewport.addEventListener('pointercancel', () => {
      touchStart = undefined;
      pausedByInteraction = false;
      schedule();
    });

    viewport.addEventListener('click', (event) => {
      if (suppressClick) {
        event.preventDefault();
        event.stopPropagation();
      }
    }, { capture: true });

    carousel.addEventListener('mouseenter', () => {
      pausedByInteraction = true;
      stopTimer();
    });
    carousel.addEventListener('mouseleave', () => {
      pausedByInteraction = false;
      schedule();
    });
    carousel.addEventListener('focusin', () => {
      pausedByInteraction = true;
      stopTimer();
    });
    carousel.addEventListener('focusout', (event) => {
      if (carousel.contains(event.relatedTarget as Node | null)) return;
      pausedByInteraction = false;
      schedule();
    });
    document.addEventListener('visibilitychange', schedule);

    dotsHost.addEventListener('animationend', (event) => {
      if (event.target !== dotsHost) return;
      dotsHost.classList.remove('is-advancing', 'is-retreating');
    });

    panels.forEach((panel) => {
      if (!panel.hasAttribute('data-carousel-original')) panel.toggleAttribute('inert', true);
    });
    schedule();
  });
</script>
