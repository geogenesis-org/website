---
interface Props {
  tone?: 'light' | 'mid' | 'dark';
  large?: boolean;
}

const { tone = 'mid', large = false } = Astro.props;
---

<div
  class:list={['news-art', `tone-${tone}`, { large }]}
  role="img"
  aria-label="GeoGenesis 动态视觉"
>
  <span class="visual-label">GEO / NEWS</span>
  <span class="news-texture" aria-hidden="true"></span>
  <span class="news-shape" aria-hidden="true"></span>
</div>
